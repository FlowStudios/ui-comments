{
  "name": "ui-comments",
  "version": "0.3.0",
  "description": "Click an element on a live page, leave a note, get a GitHub issue with everything needed to find it in source.",
  "license": "UNLICENSED",
  "private": false,
  "main": "server/github.js",
  "files": [
    "client",
    "react",
    "server",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./server/github.d.ts",
      "default": "./server/github.js"
    },
    "./client/ui-comments.js": {
      "types": "./client/ui-comments.d.ts",
      "default": "./client/ui-comments.js"
    },
    "./react/UIComments": {
      "types": "./react/UIComments.d.ts",
      "default": "./react/UIComments.js"
    },
    "./server/github": {
      "types": "./server/github.d.ts",
      "default": "./server/github.js"
    },
    "./server/next-route": {
      "types": "./server/next-route.d.ts",
      "default": "./server/next-route.js"
    }
  },
  "keywords": [
    "github",
    "issues",
    "feedback",
    "ui",
    "design-review"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlowStudios/ui-comments.git"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "types": "server/github.d.ts"
}
